{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/torch-spyre/torch-spyre/sdscbundle-schema.json",
  "title": "SDSC Bundle JSON Schema",
  "description": "JSON Schema for SDSC Bundle format. This schema covers compute operations (SFP, matmul, BMM, identity) and data operations (transpose, slice).",
  "version": "1.2.0",
  "$comment": "Version History: v1.0.0 - Initial schema. v1.0.1 (2026-05-11) - Corrected dsType_ enum to match torch_spyre constants: INPUT, OUTPUT, KERNEL, KERNEL_IDX. v1.1.0 (2026-05-XX) - Added symbolic representation: SymbolicDimInfo def, DimPaddingSizes def, DataStructDims.symbolicDimInfo_/dims_/paddingSizes_, SuperDsc symbolic fields (dimToSymbolMappingOpcodeCorrection_, inputSymbolsAndTags_, symbolDefinitions_), DesignSpaceConfig.dimToSymbolMapping_, ScheduleTreeNode.isStartAddrSymbolic_. v1.1.1 (2026-07-07) - Allow isStartAddrSymbolic_ to accept integer 0/1 in addition to boolean false/true. v1.1.2 (2026-07-07) - Allow DataStructDims direct dimension fields to accept empty object {} in addition to integer >= 1. v1.2.0 (2026-07-08) - Sync DataStructDims/DimPaddingSizes/SymbolicDimInfo with deeptools-schema.json v1.3.0 (source: dsc/dims.h + dsc/dims.cpp exportJson()): DataStructDims: added explicit dim fields (in_, out_, mb_, i_, j_, ki_, kj_, x_, x1_, y_, r_, c_, ij_, rc_, kij_, sij_, zij_, si_, sj_, zi_, zj_), added coreletSplit_, rowSplit_, peSfpSplit_, maxSymbolicVolume_, removed spurious dims_ field. DimPaddingSizes: corrected frontPadding_->padFront_, backPadding_->padBack_, removed kernelDim_, added unneededPad_, unneededPadFront_, unneededPadBack_, totalSize_, dilation_, windowDim_. SymbolicDimInfo: corrected maxValue_->maxSize_. dataStageParam_ per-stage object: added name_ field.",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z0-9_/\\-][a-zA-Z0-9_/\\-]*$": {
      "$ref": "#/$defs/SuperDsc"
    }
  },
  "additionalProperties": false,
  "minProperties": 1,
  "$defs": {
    "SuperDsc": {
      "type": "object",
      "description": "Bundle-level configuration for multi-core accelerator operation.",
      "required": ["coreFoldProp_", "coreletFoldProp_", "numCoresUsed_", "coreIdToDsc_", "coreIdToDscSchedule", "dscs_"],
      "properties": {
        "sdscFoldProps_": {
          "type": "array",
          "description": "SDSC-level fold properties",
          "items": {"$ref": "#/$defs/FoldProperty"}
        },
        "sdscFolds_": {
          "$ref": "#/$defs/FoldManager",
          "description": "SDSC-level fold manager"
        },
        "coreFoldProp_": {
          "$ref": "#/$defs/FoldProperty",
          "description": "Core fold properties"
        },
        "coreletFoldProp_": {
          "$ref": "#/$defs/FoldProperty",
          "description": "Corelet fold properties"
        },
        "numCoresUsed_": {
          "type": "integer",
          "description": "Total number of cores used",
          "minimum": 1
        },
        "dimToSymbolMappingOpcodeCorrection_": {
          "type": "object",
          "description": "Symbol mapping corrections for opcode generation",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {"type": "string"}
          }
        },
        "inputSymbolsAndTags_": {
          "type": "object",
          "description": "Input symbols and their associated tags",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {"type": "string"}
          }
        },
        "symbolDefinitions_": {
          "type": "object",
          "description": "Variable definitions for symbolic dimensions"
        },
        "coreIdToDsc_": {
          "type": "object",
          "description": "Mapping from core ID to DSC index",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "numWkSlicesPerDim_": {
          "type": "object",
          "description": "Number of work slices per dimension",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "coreIdToWkSlice_": {
          "type": "object",
          "description": "Mapping from core ID to work slice indices",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "object",
              "patternProperties": {
                "^[A-Za-z_][A-Za-z0-9_]*$": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "coreIdToDscSchedule": {
          "type": "object",
          "description": "Per-core DSC scheduling information",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "array",
              "items": {
                "type": "array",
                "description": "[datadsc_idx, dldsc_idx, before_sync, after_sync]",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "integer"}
              }
            }
          }
        },
        "dscs_": {
          "type": "array",
          "description": "Array of Design Space Configurations",
          "minItems": 1,
          "items": {"$ref": "#/$defs/WrappedDesignSpaceConfig"}
        }
      },
      "additionalProperties": false
    },
    "FoldProperty": {
      "type": "object",
      "description": "Fold property with factor and label",
      "required": ["factor_", "label_"],
      "properties": {
        "factor_": {
          "type": "integer",
          "description": "Fold factor",
          "minimum": 1
        },
        "label_": {
          "type": "string",
          "description": "Fold label (e.g., 'core', 'corelet', 'time')"
        }
      },
      "additionalProperties": false
    },
    "FoldManager": {
      "type": "object",
      "description": "Fold manager for multi-dimensional data access",
      "required": ["dim_prop_func", "dim_prop_attr"],
      "properties": {
        "dim_prop_func": {
          "type": "array",
          "description": "Dimension property functions (Const, Map, Affine, WkSplit)",
          "items": {
            "type": "object",
            "properties": {
              "Const": {"type": "object"},
              "Map": {"type": "object"},
              "Affine": {
                "type": "object",
                "properties": {
                  "alpha_": {"type": "integer"},
                  "beta_": {"type": "integer"}
                }
              },
              "WkSplit": {"type": "object"}
            }
          }
        },
        "dim_prop_attr": {
          "type": "array",
          "description": "Dimension property attributes",
          "items": {"$ref": "#/$defs/FoldProperty"}
        },
        "data_": {
          "type": "object",
          "description": "Data values indexed by fold coordinates",
          "patternProperties": {
            "^\\[[0-9, ]+\\]$": {
              "oneOf": [
                {"type": "string"},
                {"type": "integer"},
                {"type": "array", "items": {"type": "integer"}}
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "WrappedDesignSpaceConfig": {
      "description": "DSC wrapped in operation name key - used in dscs_ array",
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_/\\-][a-zA-Z0-9_/\\-]*$": {
          "$ref": "#/$defs/DesignSpaceConfig"
        }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1
    },
    "DesignSpaceConfig": {
      "type": "object",
      "description": "Design Space Configuration for operation on one or more cores. Generated by generate_sfp_op(), _generate_matmul_common(), generate_identity(), generate_transpose(), etc.",
      "required": ["numCoresUsed_", "coreIdsUsed_", "N_", "computeOp_", "labeledDs_", "scheduleTree_"],
      "properties": {
        "numCoresUsed_": {
          "type": "integer",
          "description": "Number of cores used by this DSC - written by all generate functions",
          "minimum": 1
        },
        "numCoreletsUsed_": {
          "type": "integer",
          "description": "Number of corelets used - written by all generate functions",
          "minimum": 1
        },
        "coreIdsUsed_": {
          "type": "array",
          "description": "Array of core IDs used - written by all generate functions",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "N_": {
          "$ref": "#/$defs/DataStructDims",
          "description": "Total tensor dimensions - written by all generate functions"
        },
        "dimToSymbolMapping_": {
          "type": "object",
          "description": "Mapping from dimensions to symbolic variables",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "coordinateMasking_": {
          "type": "object",
          "description": "Coordinate masking configuration - written by generate functions"
        },
        "maskingConstId_": {
          "type": "integer",
          "description": "Masking constant ID - written by generate functions"
        },
        "dataStageParam_": {
          "type": "object",
          "description": "Data staging parameters per core - written by generate_sfp_op() and _generate_matmul_common()",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "object",
              "required": ["ss_", "el_"],
              "properties": {
                "name_": {
                  "type": "string",
                  "description": "Stage name",
                  "enum": ["core", "corelet", "row"]
                },
                "ss_": {
                  "$ref": "#/$defs/DataStructDims",
                  "description": "Stage size dimensions"
                },
                "el_": {
                  "$ref": "#/$defs/DataStructDims",
                  "description": "Element dimensions"
                }
              }
            }
          }
        },
        "primaryDsInfo_": {
          "type": "object",
          "description": "Primary data structure layout info - written by all generate functions",
          "patternProperties": {
            "^[A-Z_]+$": {
              "type": "object",
              "properties": {
                "layoutDimOrder_": {
                  "type": "array",
                  "description": "Layout dimension order",
                  "items": {"type": "string"}
                },
                "stickDimOrder_": {
                  "type": "array",
                  "description": "Stick dimension order",
                  "items": {"type": "string"}
                },
                "stickSize_": {
                  "type": "array",
                  "description": "Stick sizes",
                  "items": {"type": "integer", "minimum": 1}
                }
              }
            }
          }
        },
        "scheduleTree_": {
          "type": "array",
          "description": "Schedule tree nodes - written by all generate functions",
          "items": {"$ref": "#/$defs/ScheduleTreeNode"}
        },
        "labeledDs_": {
          "type": "array",
          "description": "Labeled data structures - written by all generate functions",
          "items": {"$ref": "#/$defs/LabeledDataStructure"}
        },
        "constantInfo_": {
          "oneOf": [
            {
              "type": "object",
              "description": "Constants used in the operation - written by generate_constant_info()",
              "patternProperties": {
                "^[0-9]+$": {"$ref": "#/$defs/ConstantInfo"}
              }
            },
            {
              "type": "string",
              "description": "Empty constants as string - written by generate_constant_info() when no constants",
              "enum": ["{}"]
            }
          ]
        },
        "computeOp_": {
          "type": "array",
          "description": "Compute operations - written by all generate functions",
          "items": {"$ref": "#/$defs/ComputeOperation"}
        }
      },
      "additionalProperties": false
    },
    "DataStructDims": {
      "type": "object",
      "description": "Data structure dimensions. Serialized by DataStructDims::exportJson() in dsc/dims.cpp. All numeric dim values are doubles (default -1 = unset). Primary dims (in_, out_, mb_, i_, j_, ki_, kj_, x_, x1_, y_) are always serialized. Deprecated dims (r_, c_, ij_, rc_, kij_, sij_, zij_, si_, sj_, zi_, zj_) are serialized unless skipDeprecatedFields=true.",
      "properties": {
        "name_": {
          "type": "string",
          "description": "Dimension set name"
        },
        "in_": {"type": "number", "description": "Input features (or channels). -1 = unset."},
        "out_": {"type": "number", "description": "Output features (or channels). -1 = unset."},
        "mb_": {"type": "number", "description": "Minibatch size. -1 = unset."},
        "i_": {"type": "number", "description": "Output image rows (derived). -1 = unset."},
        "j_": {"type": "number", "description": "Output image cols (derived). -1 = unset."},
        "ki_": {"type": "number", "description": "Kernel rows (derived). -1 = unset."},
        "kj_": {"type": "number", "description": "Kernel cols (derived). -1 = unset."},
        "x_": {"type": "number", "description": "Repeat dim that does not add reuse (e.g. attention heads). -1 = unset."},
        "x1_": {"type": "number", "description": "Additional repeat dim (e.g. attention heads). -1 = unset."},
        "y_": {"type": "number", "description": "Kernel reuse dimension (e.g. timestep). -1 = unset."},
        "r_": {"type": "number", "description": "[deprecated] Input image rows with zero padding. -1 = unset."},
        "c_": {"type": "number", "description": "[deprecated] Input image cols with zero padding. -1 = unset."},
        "ij_": {"type": "number", "description": "[deprecated] Output image dimensions rows/cols. -1 = unset."},
        "rc_": {"type": "number", "description": "[deprecated] Input image rows/cols with zero padding. -1 = unset."},
        "kij_": {"type": "number", "description": "[deprecated] Kernel dimensions rows/cols. -1 = unset."},
        "sij_": {"type": "number", "description": "[deprecated] Stride dimensions rows/cols. -1 = unset."},
        "zij_": {"type": "number", "description": "[deprecated] Zero pad dimensions rows/cols. -1 = unset."},
        "si_": {"type": "number", "description": "[deprecated] Stride along rows. -1 = unset."},
        "sj_": {"type": "number", "description": "[deprecated] Stride along cols. -1 = unset."},
        "zi_": {"type": "number", "description": "[deprecated] Zero pad rows. -1 = unset."},
        "zj_": {"type": "number", "description": "[deprecated] Zero pad cols. -1 = unset."},
        "symbolicDimInfo_": {
          "type": "object",
          "description": "Per-dimension symbolic size info. Keys are primary dim names (e.g. 'in_', 'mb_'); values are SymbolicDimInfo objects.",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/SymbolicDimInfo"
            }
          }
        },
        "maxSymbolicVolume_": {
          "type": "object",
          "description": "Maximum combined symbolic volume for a set of symbolic dims. Keys are dim-set arrays encoded as strings (e.g. '[\"in_\",\"mb_\"]'); values are integer max volumes.",
          "additionalProperties": {"type": "integer"}
        },
        "coreletSplit_": {
          "type": "object",
          "description": "Per-dimension explicit work split across corelets. Keys are primary dim names; values are arrays of integer work sizes, one entry per corelet.",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "type": "array",
              "items": {"type": "integer"}
            }
          }
        },
        "rowSplit_": {
          "type": "object",
          "description": "Per-dimension, per-corelet explicit work split across PT rows. Keys are primary dim names; values are objects keyed by corelet id (numeric string) whose values are arrays of integer work sizes per PT row.",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "type": "object",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "array",
                  "items": {"type": "integer"}
                }
              }
            }
          }
        },
        "peSfpSplit_": {
          "type": "object",
          "description": "Per-dimension, per-corelet work split between PE and SFP components. Keys are primary dim names; values are objects keyed by corelet id (numeric string) whose values are objects mapping component name (e.g. 'pe', 'sfp') to integer work size.",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "type": "object",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "object",
                  "additionalProperties": {"type": "integer"}
                }
              }
            }
          }
        },
        "paddingSizes_": {
          "type": "object",
          "description": "Per-dimension padding information. Keys are primary dim names (e.g. 'r_', 'c_'); values are DimPaddingSizes objects.",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/DimPaddingSizes"
            }
          }
        }
      }
    },
    "ScheduleTreeNode": {
      "type": "object",
      "description": "Schedule tree node for memory allocation or data movement",
      "required": ["nodeType_", "name_"],
      "properties": {
        "nodeType_": {
          "type": "string",
          "description": "Node type",
          "enum": ["allocate"]
        },
        "name_": {
          "type": "string",
          "description": "Node name"
        },
        "prev_": {
          "type": "string",
          "description": "Previous node name"
        },
        "ldsIdx_": {
          "type": "integer",
          "description": "Labeled data structure index",
          "minimum": 0
        },
        "component_": {
          "type": "string",
          "description": "Memory component",
          "enum": ["hbm", "lx"]
        },
        "layoutDimOrder_": {
          "type": "array",
          "description": "Layout dimension order",
          "items": {"type": "string"}
        },
        "maxDimSizes_": {
          "type": "array",
          "description": "Maximum dimension sizes",
          "items": {"type": "integer"}
        },
        "isStartAddrSymbolic_": {
          "description": "Whether start addresses are symbolic (boolean true/false or integer 1/0)",
          "oneOf": [
            {"type": "boolean"},
            {"type": "integer", "enum": [0, 1]}
          ]
        },
        "startAddressCoreCorelet_": {
          "$ref": "#/$defs/FoldManager",
          "description": "Start address per core/corelet"
        },
        "backGapCore_": {
          "type": "object",
          "description": "Back gaps in number of elements per dimension per core - written conditionally if tensor.backGap is True",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "type": "object",
              "patternProperties": {
                "^-?[0-9]+$": {"type": "string"}
              }
            }
          }
        },
        "coordinates_": {
          "type": "object",
          "description": "Coordinate information",
          "properties": {
            "coordInfo": {
              "type": "object",
              "description": "Coordinate info per dimension",
              "patternProperties": {
                "^[a-z_][a-z0-9_]*$": {
                  "$ref": "#/$defs/CoordinateInfo"
                }
              }
            },
            "coreIdToWkSlice_": {
              "type": "object",
              "description": "Core ID to work slice mapping"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "CoordinateInfo": {
      "type": "object",
      "description": "Coordinate information for a dimension",
      "required": ["spatial", "temporal", "elemArr", "padding", "folds"],
      "properties": {
        "spatial": {
          "type": "integer",
          "description": "Spatial level",
          "minimum": 0
        },
        "temporal": {
          "type": "integer",
          "description": "Temporal level",
          "minimum": 0
        },
        "elemArr": {
          "type": "integer",
          "description": "Element array level",
          "minimum": 0
        },
        "padding": {
          "type": "string",
          "description": "Padding type",
          "enum": ["nopad", "pad"]
        },
        "folds": {
          "$ref": "#/$defs/FoldManager",
          "description": "Fold manager for this coordinate"
        }
      },
      "additionalProperties": false
    },
    "LabeledDataStructure": {
      "type": "object",
      "description": "Labeled data structure definition",
      "required": ["ldsIdx_", "dsName_", "dsType_", "dataFormat_", "memOrg_"],
      "properties": {
        "ldsIdx_": {
          "type": "integer",
          "description": "Labeled data structure index",
          "minimum": 0
        },
        "dsName_": {
          "type": "string",
          "description": "Data structure name"
        },
        "dsType_": {
          "type": "string",
          "description": "Data structure type (from torch_spyre LAYOUT_INPUT_LABELS and LAYOUT_OUTPUT_LABELS)",
          "enum": ["INPUT", "OUTPUT", "KERNEL", "KERNEL_IDX"]
        },
        "scale_": {
          "type": "array",
          "description": "Scale factors",
          "items": {"type": "number"}
        },
        "wordLength": {
          "type": "integer",
          "description": "Word length in bytes",
          "minimum": 1
        },
        "dataFormat_": {
          "type": "string",
          "description": "Data format",
          "enum": ["SEN169_FP16", "SEN169_BFP16", "SEN169_FP32", "SEN169_INT8", "SEN169_INT16", "SEN169_INT32"]
        },
        "memOrg_": {
          "type": "object",
          "description": "Memory organization",
          "properties": {
            "hbm": {
              "type": "object",
              "properties": {
                "isPresent": {"type": "integer", "enum": [0, 1]}
              }
            },
            "lx": {
              "type": "object",
              "properties": {
                "isPresent": {"type": "integer", "enum": [0, 1]}
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "ComputeOperation": {
      "type": "object",
      "description": "Compute operation specification",
      "required": ["exUnit", "opFuncName", "inputLabeledDs", "outputLabeledDs"],
      "properties": {
        "exUnit": {
          "type": "string",
          "description": "Execution unit",
          "enum": ["sfp", "pt"]
        },
        "opFuncName": {
          "type": "string",
          "description": "Operation function name - supports all torch-spyre generated operations"
        },
        "attributes_": {
          "type": "object",
          "description": "Operation attributes",
          "properties": {
            "dataFormat_": {
              "type": "string",
              "description": "Data format"
            },
            "fidelity_": {
              "type": "string",
              "description": "Computation fidelity",
              "enum": ["regular", "high", "low"]
            }
          }
        },
        "location": {
          "type": "string",
          "description": "Operation location",
          "enum": ["Inner", "Outer"]
        },
        "inputLabeledDs": {
          "type": "array",
          "description": "Input labeled data structures",
          "items": {"type": "string"}
        },
        "outputLabeledDs": {
          "type": "array",
          "description": "Output labeled data structures",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "DimPaddingSizes": {
      "type": "object",
      "description": "Padding sizes for a single dimension. Source: struct DimPaddingSizes in dsc/dims.h; serialized by DataStructDims::exportJson() in dsc/dims.cpp.",
      "properties": {
        "padFront_": {"type": "integer", "description": "Front padding elements. Default 0."},
        "padBack_": {"type": "integer", "description": "Back padding elements. Default 0."},
        "unneededPad_": {"type": "integer", "description": "Total unneeded padding elements."},
        "unneededPadFront_": {"type": "integer", "description": "Unneeded elements originating from padFront_."},
        "unneededPadBack_": {"type": "integer", "description": "Unneeded elements originating from padBack_."},
        "totalSize_": {
          "description": "Computed total padded size. The string 'N/A' when windowDim_ is unset and padFront_ < 0.",
          "oneOf": [
            {"type": "integer"},
            {"type": "string", "enum": ["N/A"]}
          ]
        },
        "stride_": {"type": "integer", "minimum": 1, "description": "Stride. Default 1."},
        "dilation_": {"type": "integer", "minimum": 1, "description": "Dilation. Default 1."},
        "windowDim_": {"type": "string", "description": "Associated window primary dim name (e.g. 'kij_'). Uses primaryDimToString mapping."}
      }
    },
    "SymbolicDimInfo": {
      "type": "object",
      "description": "Symbolic dimension info for runtime-variable dimensions. Source: struct SymbolicDimInfo in dsc/dims.h.",
      "required": ["maxSize_", "granularity_"],
      "properties": {
        "maxSize_": {"type": "integer", "minimum": 1, "description": "Maximum value of this symbolic dimension."},
        "granularity_": {"type": "integer", "minimum": 1, "description": "Step granularity of this symbolic dimension."}
      },
      "additionalProperties": false
    },
    "ConstantInfo": {
      "type": "object",
      "description": "Constant information - written by generate_constant_info()",
